{
  "name": "hecate-lunar-navigator",
  "private": true,
  "version": "2.1.0",
  "description": "HECATE - Lunar Landing Site Navigator (NASA Space Apps 2026). React + TypeScript + Three.js decision-support app for the lunar South Pole on a full-Moon 3D globe.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
